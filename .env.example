VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Discord OAuth is configured in Supabase Dashboard > Authentication > Providers > Discord.
# Never put a Discord client secret, bot token, or Supabase service-role key in VITE_* variables.

# Optional read-only catalog database (characters, teams, costs, career stats).
# Keep this separate from VITE_SUPABASE_URL: the tactical-match tables live in the main project.
VITE_CATALOG_SUPABASE_URL=https://YOUR_CATALOG_PROJECT.supabase.co
VITE_CATALOG_SUPABASE_ANON_KEY=YOUR_CATALOG_PUBLISHABLE_OR_ANON_KEY
