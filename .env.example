VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Discord OAuth is configured in Supabase Dashboard > Authentication > Providers > Discord.
# Never put a Discord client secret, bot token, or Supabase service-role key in VITE_* variables.
# Catalog access is proxied by supabase/functions/catalog-read using server-side secrets:
# CATALOG_SUPABASE_URL and CATALOG_SUPABASE_SERVICE_ROLE_KEY.
# Configure those secrets in the existing auth/match Supabase project before enabling the API.
